# Copia este archivo como .env y ajusta los valores.
# El .env está en .gitignore: nunca se sube al repositorio.

# IP del host que se usa en los enlaces "Abrir" de los contenedores.
# Déjalo vacío para que se detecte automáticamente.
HOST_IP=

# Interfaz donde se publica el panel. 0.0.0.0 = toda la red local.
# Detrás de un proxy inverso, usa 127.0.0.1.
BIND_ADDR=0.0.0.0

# IP del contenedor del proxy inverso (Nginx Proxy Manager, Traefik...).
# Solo si el panel va detrás de uno; si no, déjalo vacío.
TRUSTED_PROXIES=
